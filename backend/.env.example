# Required for Gemini query expansion, seed selection, and reranking configuration.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Recommended for higher Semantic Scholar request limits. OpenAlex accepts requests
# without a key, but a contact email is recommended by its API etiquette.
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
MAIL=you@example.com

# Local application settings.
DATABASE_PATH=../data/research_finder.duckdb
FRONTEND_ORIGIN=http://localhost:5173
SEARCH_TIMEOUT_SECONDS=20
SEARCH_LIMIT_PER_SOURCE=15
MAX_EXPANDED_TERMS=15

# Reranking: set exactly one mode.
# remote = use the Colab service; paste the live https://*.trycloudflare.com URL below.
# local  = run the models on this machine's CUDA-capable GPU.
# disabled = skip model reranking.
RERANKER_MODE=remote
COLAB_RERANKER_URL=
BI_ENCODER_MODEL=Alibaba-NLP/gte-modernbert-base
CROSS_ENCODER_MODEL=BAAI/bge-reranker-v2-m3
